# Copy to .env. Leave keys empty to run the agent in rule-based mode (dashboard + physics still work).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional offline fallback via Ollama (must support tool calling, e.g. qwen3)
LOCAL_BASE_URL=
LOCAL_MODEL=qwen3:4b
# Optional: require X-Operator-Token header for approve/reject
OPERATOR_TOKEN=
