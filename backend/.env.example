# Optional. Without a key the deterministic fallback agent is used.
# DeepSeek (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Check the exact model name in the DeepSeek console / GET {LLM_BASE_URL}/models
ORBITALGUARD_MODEL=deepseek-v4-flash

# Local model via Ollama instead (no internet needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# ORBITALGUARD_MODEL=qwen3:8b

# Screening thresholds (km)
SCREEN_THRESHOLD_KM=5.0
